{
  "name": "grocerystore-backend",
  "version": "1.0.0",
  "description": "VPS-Hosted Grocery Store POS Backend API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').mkdirSync('dist/services', {recursive: true}); require('fs').copyFileSync('src/services/printer_engine.ps1', 'dist/services/printer_engine.ps1')\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "keywords": [
    "pos",
    "grocery",
    "vps",
    "retail"
  ],
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "sqlite3": "^5.1.7",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.4",
    "@types/sqlite3": "^3.1.11",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
